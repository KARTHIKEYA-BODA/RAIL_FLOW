# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Configuration (using the free current model)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Gemini API Settings
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1000

# Station Master demo access (4–12 digits). Set as process environment variables.
STATION_MASTER_PIN=
# RailRadar API key; backend only. Do not put this in a VITE_ variable.
RAILRADAR_API_KEY=
